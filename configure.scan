#                                               -*- Autoconf -*-
# Process this file with autoconf to produce a configure script.

AC_PREREQ([2.71])
AC_INIT([FULL-PACKAGE-NAME], [VERSION], [BUG-REPORT-ADDRESS])
AC_CONFIG_SRCDIR([0730/hello.c])
AC_CONFIG_HEADERS([config.h])

# Checks for programs.
AC_PROG_CC

# Checks for libraries.
# FIXME: Replace 'main' with a function in '-ldl':
AC_CHECK_LIB([dl], [main])
# FIXME: Replace 'main' with a function in '-ljpeg':
AC_CHECK_LIB([jpeg], [main])
# FIXME: Replace 'main' with a function in '-llcd':
AC_CHECK_LIB([lcd], [main])
# FIXME: Replace 'main' with a function in '-llife':
AC_CHECK_LIB([life], [main])

# Checks for header files.
AC_CHECK_HEADERS([fcntl.h stdint.h strings.h sys/ioctl.h sys/time.h unistd.h])

# Checks for typedefs, structures, and compiler characteristics.
AC_CHECK_HEADER_STDBOOL
AC_C_INLINE
AC_TYPE_INT16_T
AC_TYPE_INT32_T
AC_TYPE_INT64_T
AC_TYPE_INT8_T
AC_TYPE_SIZE_T
AC_TYPE_UINT32_T

# Checks for library functions.
AC_FUNC_MALLOC
AC_FUNC_MMAP
AC_FUNC_REALLOC
AC_CHECK_FUNCS([bzero getcwd memset mkdir munmap strchr strerror strstr])

AC_CONFIG_FILES([file-io/classpractice/0820/Makefile
                 file-io/classpractice/0820/lib/Makefile
                 file-io/classpractice/0820/src/Makefile
                 file-io/classpractice/src/Makefile])
AC_OUTPUT
